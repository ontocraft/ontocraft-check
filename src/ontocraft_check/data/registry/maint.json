 "terms": [
  {
   "id": "item",
   "ko": "아이템",
   "en": "item",
   "alt": [
    "품목"
   ],
   "definition": "보전과 신뢰성 분석에서 따로 떼어 다룰 수 있는 대상을 모두 가리키는 말입니다. 부품 하나일 수도 있고 설비 한 대나 시스템 전체일 수도 있습니다.",
   "category": "item",
   "related": [
    "equipment-unit",
    "maintainable-item"
   ],
   "refs": [
    "IEC 60050-192",
    "EN 13306"
   ]
  },
  {
   "id": "asset",
   "ko": "자산",
   "en": "asset",
   "alt": [
    "물적 자산"
   ],
   "definition": "조직에 가치를 주거나 줄 수 있어 관리하는 대상입니다. 설비 보전에서는 주로 설비, 건물, 배관 같은 물적 자산을 뜻합니다.",
   "category": "item",
   "related": [
    "equipment-unit",
    "equipment-register"
   ],
   "refs": [
    "ISO 55000"
   ]
  },
  {
   "id": "equipment-unit",
   "ko": "설비 단위",
   "en": "equipment unit",
   "alt": [
    "설비",
    "장비"
   ],
   "definition": "펌프, 압축기, 열교환기처럼 하나의 기능을 맡는 설비 한 대입니다. 고장과 정비 기록을 모으는 기본 단위로 씁니다.",
   "category": "item",
   "broader": "item",
   "related": [
    "subunit",
    "equipment-tag"
   ],
   "refs": [
    "ISO 14224"
   ]
  },
  {
   "id": "subunit",
   "ko": "하위 단위",
   "en": "subunit",
   "alt": [
    "서브유닛"
   ],
   "definition": "설비 단위 안에서 동력 전달, 윤활, 제어처럼 하나의 하위 기능을 맡는 부분입니다.",
   "category": "item",
   "broader": "equipment-unit",
   "related": [
    "maintainable-item",
    "equipment-unit",
    "equipment-hierarchy"
   ],
   "refs": [
    "ISO 14224"
   ]
  },
  {
   "id": "maintainable-item",
   "ko": "보전 가능 아이템",
   "en": "maintainable item",
   "alt": [
    "보전 단위"
   ],
   "definition": "정비 작업에서 한 번에 고치거나 바꾸는 가장 작은 단위입니다. 베어링, 씰, 임펠러 같은 부품이 여기에 해당합니다.",
   "category": "item",
   "broader": "subunit",
   "related": [
    "spare-part",
    "subunit",
    "equipment-hierarchy"
   ],
   "refs": [
    "ISO 14224"
   ]
  },
  {
   "id": "spare-part",
   "ko": "예비품",
   "en": "spare part",
   "alt": [
    "스페어",
    "예비 부품"
   ],
   "definition": "고장이나 계획 정비 때 바꿔 끼우려고 미리 보관하는 부품입니다. 설비 중요도와 조달 기간을 보고 어떤 부품을 몇 개 둘지 정합니다.",
   "category": "item",
   "broader": "item",
   "related": [
    "maintainable-item",
    "spare-requirement",
    "criticality"
   ],
   "refs": [
    "EN 13306"
   ],
   "example": "작업 지시의 부품 칸에는 사용한 예비품의 품목 번호와 수량을 적어 재고에서 뺍니다."
  },
  {
   "id": "equipment-tag",
   "ko": "설비 태그",
   "en": "equipment tag",
   "alt": [
    "태그 번호",
    "기기 번호"
   ],
   "definition": "설비 하나하나에 붙이는 고유 식별 번호입니다. 도면, 정비 이력, 센서 데이터를 같은 설비로 묶는 열쇠가 됩니다.",
   "category": "item",
   "related": [
    "equipment-unit",
    "equipment-register"
   ],
   "refs": [
    "ISO 14224",
    "IEC 81346"
   ]
  },
  {
   "id": "equipment-hierarchy",
   "ko": "설비 계층",
   "en": "equipment hierarchy",
   "alt": [
    "설비 분류 체계",
    "택소노미"
   ],
   "definition": "공장, 공정 구역, 시스템, 설비 단위, 하위 단위, 보전 가능 아이템으로 내려가는 포함 관계의 구조입니다.",
   "category": "item",
   "related": [
    "equipment-unit",
    "subunit"
   ],
   "refs": [
    "ISO 14224"
   ]
  },
  {
   "id": "equipment-register",
   "ko": "설비 대장",
   "en": "equipment register",
   "alt": [
    "자산 대장",
    "설비 목록"
   ],
   "definition": "설비 태그마다 형식, 제조사, 설치일, 위치, 주요 사양을 적은 목록입니다.",
   "category": "item",
   "related": [
    "equipment-tag",
    "asset"
   ],
   "refs": [
    "ISO 55000"
   ]
  },
  {
   "id": "criticality",
   "ko": "설비 중요도",
   "en": "equipment criticality",
   "alt": [
    "설비 등급",
    "중요도 등급"
   ],
   "definition": "설비가 고장 났을 때 안전, 환경, 생산, 비용에 미치는 영향의 크기에 따라 매긴 등급입니다. 보전 방식과 예비품 수준을 정하는 기준이 됩니다.",
   "category": "item",
   "related": [
    "risk-assessment",
    "rcm"
   ],
   "refs": [
    "ISO 14224"
   ]
  },
  {
   "id": "redundancy",
   "ko": "중복 구성",
   "en": "redundancy",
   "alt": [
    "리던던시",
    "예비 계열"
   ],
   "definition": "같은 기능을 하는 아이템을 둘 이상 두어 하나가 고장 나도 기능이 유지되게 하는 구성입니다.",
   "category": "item",
   "related": [
    "availability",
    "common-cause-failure"
   ],
   "refs": [
    "IEC 60050-192"
   ]
  },
  {
   "id": "operating-context",
   "ko": "운전 조건",
   "en": "operating context",
   "alt": [
    "운전 환경",
    "사용 조건"
   ],
   "definition": "설비가 놓인 환경과 운전 방식입니다. 부하, 온도, 운전 시간, 매체가 같은 형식의 설비라도 고장 양상을 다르게 만듭니다.",
   "category": "item",
   "related": [
    "rcm",
    "failure-mechanism"
   ],
   "refs": [
    "SAE JA1011"
   ]
  },
  {
   "id": "failure",
   "ko": "고장",
   "en": "failure",
   "alt": [
    "기능 상실"
   ],
   "definition": "아이템이 요구된 기능을 수행하는 능력을 잃는 사건입니다. 고장은 사건이고, 그 뒤 아이템이 놓인 상태는 결함입니다.",
   "category": "failure",
   "related": [
    "fault",
    "failure-mode",
    "failure-mechanism",
    "failure-cause"
   ],
   "refs": [
    "IEC 60050-192",
    "ISO 14224"
   ]
  },
  {
   "id": "fault",
   "ko": "결함",
   "en": "fault",
   "alt": [
    "결함 상태",
    "폴트"
   ],
   "definition": "아이템이 요구된 기능을 수행하지 못하는 상태입니다. 고장의 결과로 생기기도 하고 설계·제작 단계부터 있기도 합니다.",
   "category": "failure",
   "related": [
    "failure",
    "hidden-failure",
    "functional-failure"
   ],
   "refs": [
    "IEC 60050-192"
   ],
   "example": "고장 보고의 「예비 펌프 기동 시험 실패」는 시험 전부터 있던 결함을 시험으로 찾은 경우입니다."
  },
  {
   "id": "failure-mode",
   "ko": "고장 모드",
   "en": "failure mode",
   "alt": [
    "고장 형태",
    "고장 유형"
   ],
   "definition": "고장이 겉으로 드러나는 방식입니다. 누설, 기동 불가, 과열, 진동 과다처럼 관찰할 수 있는 말로 적습니다.",
   "category": "failure",
   "related": [
    "failure",
    "failure-mechanism",
    "failure-cause",
    "fmea"
   ],
   "refs": [
    "ISO 14224",
    "IEC 60812"
   ],
   "example": "고장 보고의 고장 모드 칸에는 「씰 누설」, 「기동 불가」처럼 관찰한 현상을 적고 원인은 따로 적습니다."
  },
  {
   "id": "failure-mechanism",
   "ko": "고장 메커니즘",
   "en": "failure mechanism",
   "alt": [
    "고장 기구"
   ],
   "definition": "고장을 일으키는 물리적, 화학적, 그 밖의 과정입니다. 피로, 부식, 마모, 과열이 대표적입니다.",
   "category": "failure",
   "related": [
    "failure",
    "failure-mode",
    "degradation"
   ],
   "refs": [
    "ISO 14224",
    "IEC 60050-192"
   ]
  },
  {
   "id": "failure-cause",
   "ko": "고장 원인",
   "en": "failure cause",
   "alt": [
    "근본 원인 후보"
   ],
   "definition": "고장으로 이어진 설계, 제작, 설치, 운전, 보전 쪽의 사정입니다. 원인을 고쳐야 같은 고장이 되풀이되지 않습니다.",
   "category": "failure",
   "related": [
    "failure",
    "rca",
    "failure-mechanism"
   ],
   "refs": [
    "ISO 14224",
    "IEC 60050-192"
   ]
  },
  {
   "id": "failure-effect",
   "ko": "고장 영향",
   "en": "failure effect",
   "alt": [
    "고장 결과"
   ],
   "definition": "고장 모드가 아이템, 상위 시스템, 안전, 생산에 미치는 결과입니다. FMEA에서 심각도를 매기는 근거가 되고, 같은 고장 모드라도 운전 조건과 중복 구성에 따라 영향이 달라집니다.",
   "category": "failure",
   "broader": "failure",
   "related": [
    "severity",
    "fmea"
   ],
   "refs": [
    "IEC 60812"
   ]
  },
  {
   "id": "hidden-failure",
   "ko": "잠재 고장",
   "en": "hidden failure",
   "alt": [
    "숨은 고장",
    "은폐 고장"
   ],
   "definition": "평소 운전 중에는 드러나지 않는 고장입니다. 안전밸브나 예비 펌프처럼 필요할 때만 작동하는 기능에서 생기며 시험해야 찾을 수 있습니다.",
   "category": "failure",
   "broader": "failure",
   "related": [
    "inspection",
    "rcm"
   ],
   "refs": [
    "SAE JA1011"
   ]
  },
  {
   "id": "functional-failure",
   "ko": "기능 고장",
   "en": "functional failure",
   "definition": "아이템이 사용자가 정한 성능 기준을 만족하지 못하는 상태입니다. 완전히 멈추지 않아도 기준 아래로 떨어지면 기능 고장입니다.",
   "category": "failure",
   "broader": "failure",
   "related": [
    "rcm",
    "partial-failure"
   ],
   "refs": [
    "SAE JA1011"
   ]
  },
  {
   "id": "random-failure",
   "ko": "우발 고장",
   "en": "random failure",
   "alt": [
    "랜덤 고장"
   ],
   "definition": "사용 기간과 관계없이 거의 일정한 비율로 생기는 고장입니다. 시간 기준 교체로는 줄이기 어렵습니다.",
   "category": "failure",
   "broader": "failure",
   "related": [
    "bathtub-curve",
    "failure-rate"
   ],
   "refs": [
    "IEC 60050-192"
   ]
  },
  {
   "id": "wear-out-failure",
   "ko": "마모 고장",
   "en": "wear-out failure",
   "alt": [
    "노화 고장"
   ],
   "definition": "사용 시간이 길어질수록 열화가 쌓여 고장 확률이 커지는 고장입니다. 피로, 부식, 마모처럼 시간이 쌓이는 고장 메커니즘에서 나오므로 시간기준보전이나 상태기반보전으로 미리 막을 수 있습니다.",
   "category": "failure",
   "broader": "failure",
   "related": [
    "bathtub-curve",
    "degradation",
    "time-based-maintenance"
   ],
   "refs": [
    "IEC 60050-192"
   ]
  },
  {
   "id": "early-failure",
   "ko": "초기 고장",
   "en": "early failure",
   "alt": [
    "유아 사망 고장"
   ],
   "definition": "설치나 수리 직후에 제작·조립·설치 결함 때문에 많이 생기는 고장입니다.",
   "category": "failure",
   "broader": "failure",
   "related": [
    "bathtub-curve",
    "random-failure",
    "wear-out-failure"
   ],
   "refs": [
    "IEC 60050-192"
   ]
  },
  {
   "id": "common-cause-failure",
   "ko": "공통 원인 고장",
   "en": "common cause failure",
   "alt": [
    "CCF"
   ],
   "definition": "하나의 원인 때문에 여러 아이템이 함께 고장 나는 것입니다. 중복 구성의 효과를 없앱니다.",
   "category": "failure",
   "broader": "failure",
   "related": [
    "redundancy",
    "fta"
   ],
   "refs": [
    "IEC 61508",
    "IEC 60050-192"
   ]
  },
  {
   "id": "partial-failure",
   "ko": "부분 고장",
   "en": "partial failure",
   "alt": [
    "성능 저하 고장"
   ],
   "definition": "아이템이 기능의 일부만 잃거나 성능이 줄어든 고장입니다. 설비는 계속 돌지만 유량, 압력, 속도 같은 성능이 기준에 못 미치는 경우가 여기에 들어갑니다.",
   "category": "failure",
   "broader": "failure",
   "related": [
    "functional-failure",
    "complete-failure"
   ],
   "refs": [
    "ISO 14224"
   ],
   "example": "고장 보고에 「토출 압력 저하, 운전은 계속」으로 적힌 펌프 고장은 부분 고장으로 분류합니다."
  },
  {
   "id": "complete-failure",
   "ko": "완전 고장",
   "en": "complete failure",
   "alt": [
    "치명 고장"
   ],
   "definition": "아이템이 요구된 기능을 전혀 수행하지 못하게 된 고장입니다. 설비가 멈추거나 기동하지 못하는 경우이며, 부분 고장과 나눠 기록하면 정지 시간과 고장 영향을 따로 볼 수 있습니다.",
   "category": "failure",
   "broader": "failure",
   "related": [
    "partial-failure",
    "downtime"
   ],
   "refs": [
    "ISO 14224"
   ],
   "example": "고장 보고에 「기동 불가」로 적힌 고장은 완전 고장으로 분류합니다."
  },
  {
   "id": "detection-method",
   "ko": "고장 탐지 방법",
   "en": "detection method",
   "alt": [
    "발견 방법"
   ],
   "definition": "고장을 어떻게 알게 되었는지를 적는 분류입니다. 정기 점검, 상태 감시, 운전 중 관찰, 시험, 생산 중단 같은 값이 있습니다.",
   "category": "failure",
   "related": [
    "condition-monitoring",
    "detection"
   ],
   "refs": [
    "ISO 14224"
   ]
  },
  {
   "id": "failure-symptom",
   "ko": "고장 징후",
   "en": "failure symptom",
   "alt": [
    "이상 징후",
